# Response headers for files served straight from the static assets (pages, scripts, data). Responses built by the
# Worker (/api/*) get their own headers in worker/index.js. This file cannot match query strings, so versioned
# ?v= assets get the same short cache as other code rather than "immutable".
# No CSP here yet: the pages use inline scripts, so a policy needs the Worker or a nonce build step.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000

/assets/*
  Cache-Control: public, max-age=300, stale-while-revalidate=3600

/music/assets/*
  Cache-Control: public, max-age=300, stale-while-revalidate=3600

/data/*
  Cache-Control: public, max-age=300
