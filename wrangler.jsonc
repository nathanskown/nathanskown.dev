// Cloudflare Workers config for nathanskown.dev. The name must match the Worker in the Cloudflare dashboard.
{
  "name": "nathanskown-dev",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true },
  // Music leaderboard storage. The migration creates the SQLite-backed Durable Object on the next deploy.
  "durable_objects": {
    "bindings": [{ "name": "MUSIC_BOARD", "class_name": "MusicBoard" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MusicBoard"] }],
  // /api/quote: at most 60 uncached lookups per visitor per minute (cache hits are free and not counted)
  "ratelimits": [{ "name": "QUOTE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }]
}
