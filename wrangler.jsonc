// Cloudflare Workers config for nathanskown.dev. The name must match the Worker in the Cloudflare dashboard.
{
  "name": "nathanskown-dev",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
